<Window x:Class="YourNamespace.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bejelentkezés" Height="400" Width="400" WindowStartupLocation="CenterScreen" Background="#f3f4f6">
    <Grid Margin="20">
        <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Padding="20">
            <StackPanel>
                <TextBlock Text="Bejelentkezés" FontSize="24" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <TextBlock Text="Felhasználónév:" Foreground="#6B7280" Margin="0,0,0,5"/>
                <Border Background="#E5E7EB" BorderBrush="#9CA3AF" BorderThickness="1" CornerRadius="5" Margin="0,0,0,15">
                    <TextBox Name="UsernameTextBox" Text="user1" Background="Transparent" Padding="5" Height="35"/>
                </Border>

                <TextBlock Text="Jelszó:" Foreground="#6B7280" Margin="0,0,0,5"/>
                <Border Background="#E5E7EB" BorderBrush="#9CA3AF" BorderThickness="1" CornerRadius="5" Margin="0,0,0,15">
                    <PasswordBox Name="PasswordBox" Password="Titkos1" Background="Transparent" Padding="5" Height="35"/>
                </Border>

                <Button Content="Belépés" Width="300" Height="40" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Margin="0,10,0,15" 
                        HorizontalAlignment="Center" Cursor="Hand" Click="LoginButton_Click"/>

                <TextBlock Name="ErrorMessage" Foreground="#DC2626" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
