<Window x:Class="admin_felület.adminpanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Panel" Height="450" Width="800">
    <Grid>
        <Button Content="Load Products" HorizontalAlignment="Left" VerticalAlignment="Top" Width="120" Height="30" Click="LoadProductsButton_Click"/>
        <DataGrid x:Name="TermekekDataGrid" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,50,0,0" />
        <TextBox x:Name="ErrorTextBox" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="100" Margin="0,0,0,10" IsReadOnly="True" Background="LightGray" />
    </Grid>
</Window>
