<Window x:Class="admin_felület.adminpanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Panel" Height="500" Width="800">
    <Grid>
        <Menu VerticalAlignment="Top">
            <MenuItem Header="Termékek" Click="MenuItem_Click_1">
                <MenuItem Header="Termékek adatai" Click="LoadProductsMenuItem_Click"/>
                <MenuItem Header="Termékek hozzáadása" Click="AddProductsMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="Felhasználók" Click="MenuItem_Click">
                <MenuItem Header="Felhasználók adatai" Click="LoadUsersMenuItem_Click"/>
                <MenuItem Header="Felhasználók hozzáadása" Click="AddUsersMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <!-- Termékek DataGrid -->
        <StackPanel x:Name="TermekekMegjelenitese" Margin="10">
            <DataGrid x:Name="TermekekDataGrid" SelectionChanged="TermekekDataGrid_SelectionChanged" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,30,0,0" Height="250"/>
            <Button x:Name="EditProductButton" Content="Szerkesztés" Click="EditProductButton_Click" Width="70" Height="20" Visibility="Collapsed"/>
            <Button x:Name="DeleteProductButton" Content="Törlés" Click="DeleteProductButton_Click" Height="20" Width="60" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Termék hozzáadási űrlap (alapból elrejtve) -->
        <StackPanel x:Name="TermekHozzaadasPanel" Visibility="Collapsed" Margin="10">
            <Label Content="Termék neve:"/>
            <TextBox x:Name="TermekNeveTextBox"/>

            <Label Content="Méret:"/>
            <TextBox x:Name="MeretTextBox"/>

            <Label Content="Ár:"/>
            <TextBox x:Name="ArTextBox"/>

            <Label Content="Kép URL:"/>
            <TextBox x:Name="KepTextBox"/>

            <Label Content="Kategória:"/>
            <TextBox x:Name="KategoriaTextBox"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Hozzáadási gomb -->
                <Button x:Name="HozzaadButton" Content="Hozzáadás" Click="HozzaadButton_Click" Margin="10"/>
                <!-- Mentés gomb (csak a szerkesztéshez) -->
                <Button x:Name="SaveButton" Content="Mentés" Click="SaveProductButton_Click" Margin="10" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
